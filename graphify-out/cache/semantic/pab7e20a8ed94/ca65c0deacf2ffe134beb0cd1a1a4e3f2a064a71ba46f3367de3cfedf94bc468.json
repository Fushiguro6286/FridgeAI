{"nodes": [{"id": "readme_fridgeai", "label": "FridgeAI \u2014 Smart AI Meal Planner", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ai_suggests_code_decides", "label": "The AI suggests; normal code decides", "file_type": "rationale", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM output is only a suggestion; availability, filtering, ranking, planning and shopping are computed deterministically from the user's confirmed inventory so AI claims are never trusted blindly."}, {"id": "readme_scan_flow", "label": "Fridge photo scan (vision detection, confirm before save)", "file_type": "concept", "source_file": "README.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is saved until the user confirms detected ingredients."}, {"id": "readme_recipe_generation", "label": "Recipe generation and diet/allergy filtering", "file_type": "concept", "source_file": "README.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Available/missing/optional ingredients are computed from current inventory, never from the AI's claims."}, {"id": "readme_ranking_function", "label": "Deterministic recipe ranking (score out of 100)", "file_type": "concept", "source_file": "README.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights: have-share 40, few missing 20, time 15, cuisine 10, priority ingredients 15, missing-cost penalty -10 only with real price data; diet violations score 0."}, {"id": "readme_meal_planner", "label": "Deterministic meal planner", "file_type": "concept", "source_file": "README.md", "source_location": "L84", "source_url": n