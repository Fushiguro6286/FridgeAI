# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fridgeai:fridgeai@localhost:5432/fridgeai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=720

AI_API_KEY=
# OpenRouter by default. Any OpenAI-compatible server works (OpenAI, Ollama: http://localhost:11434/v1).
AI_BASE_URL=https://openrouter.ai/api/v1
# Needs image input + structured outputs. Fastest good free model (tested Oct 2026): nvidia/nemotron-3.5-super-vl:free
# (free tier: 50 requests/day). Paid (needs OpenRouter credit): anthropic/claude-haiku-5.5, or anthropic/claude-sonnet-5.5.
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_TIMEOUT_SECONDS=120
# Skip the model's hidden "thinking" step. About 3x faster with the same results for this app. Set false if a model rejects it.
AI_DISABLE_REASONING=true

# Development/testing only: returns clearly labelled sample data instead of calling the AI model.
# Refused when ENVIRONMENT=production.
AI_MOCK_MODE=false

MAX_UPLOAD_MB=8
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
AI_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
